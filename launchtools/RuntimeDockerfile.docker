# Fork-only alternative to StandardDockerfile.docker: compile in an SDK stage, run on the
# ASP.NET runtime image. Upstream runs from the full SDK image because SwarmUI compiles
# itself and its extensions at startup (linux-build-logic.sh, ExtensionsManager.BuildExtension).
# Every HIGH trivy reported on that image (2026-10-30, SDK 8.0.427) sat in the SDK's own
# tooling -- MSBuild, the F# compiler, dotnet-format -- none of which SwarmUI runs. Doing the
# compiles here instead means the runtime image never carries them.
#
# Extensions are compiled from ./src/Extensions (gitignored), the same folder compose
# bind-mounts at runtime. Installing or updating one from the UI therefore needs a
# `docker compose build && docker compose up -d` afterwards; until then SwarmUI logs a
# CriticalLoadError for it and carries on without it.

FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim AS build

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

WORKDIR /SwarmUI
COPY . .

# .dockerignore's `bin/`/`obj/` only match at the root, so stale nested outputs can ride in.
RUN rm -rf src/bin src/obj src/Extensions/*/bin src/Extensions/*/obj

RUN dotnet build src/SwarmUI.csproj --configuration Release -o ./src/bin/live_release \
 && git config --global --add safe.directory '*' \
 && git rev-parse HEAD > src/bin/last_build

# Mirror ExtensionsManager.BuildExtension (src/Core/ExtensionsManager.cs): same output folder,
# intermediate path and TargetName, and the same autogenerated csproj (ReferenceCsproj) when an
# extension ships none. SwarmUI then finds each DLL already built and loads it instead of
# calling `dotnet build`, which the runtime image cannot do.
RUN set -eu; \
    for dir in src/Extensions/*/; do \
        dir=${dir%/}; name=${dir##*/}; \
        case "$name" in *.disable|*.delete) continue ;; esac; \
        dll="SwarmExtension$name"; \
        proj=$(ls "$dir"/*.csproj 2>/dev/null | awk '{print (tolower($0) ~ /extension/ ? 0 : 1) "\t" $0}' | sort | head -n1 | cut -f2); \
        autogen=""; \
        if [ -z "$proj" ]; then \
            proj="$dir/SwarmAutoGenExtensionProjectFile.csproj"; autogen="$proj"; \
            printf '%s\n' '<Project Sdk="Microsoft.NET.Sdk.Web">' '    <PropertyGroup>' \
                '        <AssemblyName>MyUnconfiguredExtension</AssemblyName>' '    </PropertyGroup>' \
                '    <Import Project="../../SwarmUI.extension.props" />' '</Project>' > "$proj"; \
        fi; \
        echo "== building $name -> $dll"; \
        (cd "$dir" && dotnet build "$(realpath "/SwarmUI/$proj")" -c Release \
            -o "/SwarmUI/src/bin/extensions/$dll/" \
            "-p:BaseIntermediateOutputPath=/SwarmUI/src/obj/extensions/$dll/;TargetName=$dll"); \
        test -f "src/bin/extensions/$dll/$dll.dll"; \
        [ -z "$autogen" ] || rm -f "$autogen"; \
        rm -rf "$dir/bin" "$dir/obj"; \
    done; \
    rm -rf src/obj


FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim

ARG UID=1000

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://*:7801

# The InRelease file changes whenever Debian publishes a security update, so this layer's cache
# key changes with it and the upgrade re-runs, instead of a cached layer pinning old packages.
# git: extension/version info and the admin update API. ffmpeg: video/animation output.
# libgomp1: LLamaSharp's CPU backend (it used to arrive with build-essential).
ADD https://deb.debian.org/debian-security/dists/bookworm-security/InRelease /tmp/bookworm-security.InRelease
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends git ffmpeg libgomp1 \
 && rm -rf /var/lib/apt/lists/* /tmp/bookworm-security.InRelease \
 && git config --system --add safe.directory '*' \
 && useradd -u $UID swarmui

COPY --from=build --chown=$UID:$UID /SwarmUI /SwarmUI

WORKDIR /SwarmUI
EXPOSE 7801

ENTRYPOINT ["bash", "/SwarmUI/launchtools/docker-runtime-inner.sh"]
